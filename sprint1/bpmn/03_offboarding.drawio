        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph Lane_O_Employee [\&quot;Працівник\&quot;]\n        Task_ReturnAssets[\&quot;Повернути закріплене&lt;br/&gt;корпоративне майно\&quot;]\n    end\n\n    subgraph Lane_O_HR [\&quot;HR-менеджер\&quot;]\n        Start_Offboarding((\&quot;Отримано розпорядження&lt;br/&gt;про звільнення\&quot;))\n        Task_RegisterDate[\&quot;Зареєструвати дату та&lt;br/&gt;створити обхідний лист\&quot;]\n        Gateway_ParallelSplit{\&quot;+ Розпочати паралельні&lt;br/&gt;процедури +\&quot;}\n        Gateway_ParallelJoin{\&quot;+ Синхронізувати&lt;br/&gt;завершення процедур +\&quot;}\n        Task_IssueOrder[\&quot;Оформити кадровий наказ&lt;br/&gt;та документи\&quot;]\n        Task_ArchiveCard[\&quot;Перевести картку в статус&lt;br/&gt;&#39;Звільнений&#39;\&quot;]\n        End_OffboardingClosed(((\&quot;Звільнення успішно&lt;br/&gt;оформлено\&quot;)))\n    end\n\n    subgraph Lane_O_Lead [\&quot;Керівник підрозділу\&quot;]\n        Task_AcceptProjects[\&quot;Прийняти справи,&lt;br/&gt;проєкти та доступи\&quot;]\n    end\n\n    subgraph Lane_O_Admin [\&quot;Адміністратор\&quot;]\n        Task_PlanAccountLock[\&quot;Запланувати блокування&lt;br/&gt;облікових записів\&quot;]\n    end\n\n    subgraph Lane_O_Payroll [\&quot;Бухгалтерія\&quot;]\n        SubProcess_PayrollComp[[\&quot;Розрахувати виплати й&lt;br/&gt;компенсацію відпусток\&quot;]]\n    end\n\n    %% Потоки процесу\n    Start_Offboarding --&gt; Task_RegisterDate\n    Task_RegisterDate --&gt; Gateway_ParallelSplit\n\n    %% Паралельне розгалуження (Parallel AND Split)\n    Gateway_ParallelSplit --&gt; Task_AcceptProjects\n    Gateway_ParallelSplit --&gt; Task_PlanAccountLock\n    Gateway_ParallelSplit --&gt; SubProcess_PayrollComp\n\n    %% Синхронізація (Parallel AND Join)\n    Task_AcceptProjects --&gt; Gateway_ParallelJoin\n    Task_PlanAccountLock --&gt; Gateway_ParallelJoin\n    SubProcess_PayrollComp --&gt; Gateway_ParallelJoin\n\n    %% Завершальні кроки\n    Gateway_ParallelJoin --&gt; Task_ReturnAssets\n    Task_ReturnAssets --&gt; Task_IssueOrder\n    Task_IssueOrder --&gt; Task_ArchiveCard\n    Task_ArchiveCard --&gt; End_OffboardingClosed\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IircGPcvk3YL7AicEUMZ-1">
