        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    subgraph Lane_Employee [\&quot;Працівник\&quot;]\n        Start_LeaveNeed((\&quot;Виникла потреба&lt;br/&gt;у відпустці\&quot;))\n        Task_SelectDates[\&quot;Обрати вид та дати&lt;br/&gt;відпустки\&quot;]\n        Task_SubmitRequest[\&quot;Подати заявку&lt;br/&gt;на відпустку\&quot;]\n        End_Approved(((\&quot;Відпустку&lt;br/&gt;погоджено\&quot;)))\n    end\n\n    subgraph Lane_Lead [\&quot;Керівник підрозділу\&quot;]\n        Task_ReviewRequest[\&quot;Розглянути заявку&lt;br/&gt;на відпустку\&quot;]\n        Timer_Escalate((\&quot;3 робочі дні&lt;br/&gt;без відповіді\&quot;))\n        Gateway_ManagerDecision{\&quot;Рішення&lt;br/&gt;керівника?\&quot;}\n        Task_RejectComment[\&quot;Вказати причину&lt;br/&gt;відхилення\&quot;]\n        End_Rejected(((\&quot;Відпустку&lt;br/&gt;відхилено\&quot;)))\n    end\n\n    subgraph Lane_HR [\&quot;HR-менеджер\&quot;]\n        Task_HREscalation[\&quot;Ескалаційне погодження&lt;br/&gt;HR-менеджером\&quot;]\n    end\n\n    subgraph Lane_System [\&quot;Система\&quot;]\n        SubProcess_CalcWorkDays[[\&quot;Розрахунок робочих днів&lt;br/&gt;(без свят і вихідних)\&quot;]]\n        Task_CheckBalance[\&quot;Перевірити доступний&lt;br/&gt;баланс\&quot;]\n        Gateway_BalanceCheck{\&quot;Баланс&lt;br/&gt;достатній?\&quot;}\n        Task_NotifyDeficit[\&quot;Надіслати сповіщення&lt;br/&gt;про дефіцит днів\&quot;]\n        End_Deficit(((\&quot;Заявку відхилено&lt;br/&gt;системою (дефіцит днів)\&quot;)))\n        Task_NotifyManager[\&quot;Зареєструвати та&lt;br/&gt;сповістити керівника\&quot;]\n        Task_DeductDays[\&quot;Списати дні з балансу&lt;br/&gt;працівника\&quot;]\n        Task_UpdateCalendar[\&quot;Внести запис у&lt;br/&gt;календар команди\&quot;]\n        Task_NotifyApproval[\&quot;Сповістити працівника&lt;br/&gt;про погодження\&quot;]\n    end\n\n    %% Потоки процесу\n    Start_LeaveNeed --&gt; Task_SelectDates\n    Task_SelectDates --&gt; Task_SubmitRequest\n    Task_SubmitRequest --&gt; SubProcess_CalcWorkDays\n    SubProcess_CalcWorkDays --&gt; Task_CheckBalance\n    Task_CheckBalance --&gt; Gateway_BalanceCheck\n    \n    Gateway_BalanceCheck --&gt;|\&quot;Ні, дефіцит днів\&quot;| Task_NotifyDeficit\n    Task_NotifyDeficit --&gt; End_Deficit\n    \n    Gateway_BalanceCheck --&gt;|\&quot;Так, баланс ≥ днів\&quot;| Task_NotifyManager\n    Task_NotifyManager --&gt; Task_ReviewRequest\n    \n    Task_ReviewRequest --&gt; Gateway_ManagerDecision\n    Task_ReviewRequest -.-&gt; Timer_Escalate\n    Timer_Escalate --&gt; Task_HREscalation\n    Task_HREscalation --&gt; Gateway_ManagerDecision\n    \n    Gateway_ManagerDecision --&gt;|\&quot;Відхилити\&quot;| Task_RejectComment\n    Task_RejectComment --&gt; End_Rejected\n    \n    Gateway_ManagerDecision --&gt;|\&quot;Погодити\&quot;| Task_DeductDays\n    Task_DeductDays --&gt; Task_UpdateCalendar\n    Task_UpdateCalendar --&gt; Task_NotifyApproval\n    Task_NotifyApproval --&gt; End_Approved\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="qpS-h8bxV_ccQJgN57QS-1">
