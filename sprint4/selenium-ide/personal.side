  "tests": [
    {
      "id": "e2961db4-4ead-4d5f-b8b4-e3387c6c5be9",
      "name": "TC-002 Invalid credentials",
      "commands": [
        {
          "id": "5b108e22-ac24-45fc-84a1-a98c42ab6974",
          "command": "open",
          "target": "https://opensource-demo.orangehrmlive.com/web/index.php/auth/login",
          "value": ""
        },
        {
          "command": "waitForElementVisible",
          "target": "name=username",
          "value": "20000",
          "id": "0470366b-8c15-4dd5-a1a9-a58345f1df6a"
        },
        {
          "command": "type",
          "target": "name=username",
          "value": "Admin",
          "id": "7f1ce605-e86f-4eec-93f6-2a9453aa624e",
          "comment": ""
        },
        {
          "command": "type",
          "target": "name=password",
          "value": "WrongPass1",
          "id": "bc23b7dc-0804-4805-b607-929d7fa5641e"
        },
        {
          "command": "click",
          "target": "css=button[type='submit']",
          "value": "",
          "id": "daec13c1-84dc-4021-bb7b-d25d81c06b1d"
        },
        {
          "command": "waitForElementVisible",
